# Copiá este archivo a .env y completá con los valores reales de tu proyecto
# (Settings > API en el dashboard de Supabase).
#
# IMPORTANTE: solo la clave PUBLISHABLE/ANON va acá. La secret/service_role
# NUNCA va en un archivo que empiece con VITE_ (Vite la expone al navegador).

VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
